# LLM backend — pick ONE of the options below.

# ── Option A: local Ollama (free, no API key) ──
# Auto-detected at 127.0.0.1:11434 when OPENAI_API_KEY is unset.
# OLLAMA_HOST=127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b

# ── Option B: OpenAI ──
# OPENAI_API_KEY=sk-your-key-here
# LLM_MODEL=gpt-4o-mini

# ── Option C: any OpenAI-compatible server/proxy ──
# OPENAI_API_KEY=not-needed
# OPENAI_BASE_URL=http://127.0.0.1:8001/v1
# LLM_MODEL=your-model-name

# Server
HOST=0.0.0.0
PORT=8000

# Optional
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# MAX_UPLOAD_MB=25
# SESSION_TTL_SECONDS=7200
# MAX_SESSIONS=200
# CODE_TIMEOUT_SECONDS=10
# MAX_CODE_RETRIES=2
