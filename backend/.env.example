# LLM backend — Groq is primary; local Ollama is the automatic fallback.

# ── Primary: Groq ──
# GROQ_API_KEY=gsk-your-key-here
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TIMEOUT_SECONDS=30

# Groq free-tier prompt budgeting. The defaults keep a full
# upload -> code -> chart -> explanation run below 8,000 input TPM.
# GROQ_INPUT_TPM=8000
# GROQ_MAX_INPUT_TOKENS=6000
# GROQ_CODE_PROMPT_TOKENS=3200
# GROQ_EXPLAIN_PROMPT_TOKENS=1500
# GROQ_CHART_PROMPT_TOKENS=600
# GROQ_CLARIFY_PROMPT_TOKENS=1300
# GROQ_ERROR_PROMPT_TOKENS=900
# GROQ_HISTORY_TOKENS=250
# GROQ_CONTEXT_TOKENS=200

# ── Fallback: local Ollama (free, no API key) ──
# Used automatically if Groq is unreachable or returns an error.
# OLLAMA_HOST=127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_TIMEOUT_SECONDS=25

# ── Optional: OpenAI instead of Groq ──
# OPENAI_API_KEY=sk-your-key-here
# LLM_MODEL=gpt-4o-mini

# ── Optional: any OpenAI-compatible server/proxy ──
# OPENAI_API_KEY=not-needed
# OPENAI_BASE_URL=http://127.0.0.1:8001/v1
# LLM_MODEL=your-model-name

# Server
HOST=0.0.0.0
PORT=8000

# Optional
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# MAX_UPLOAD_MB=25
# SESSION_TTL_SECONDS=7200
# MAX_SESSIONS=200
# CODE_TIMEOUT_SECONDS=10
# MAX_CODE_RETRIES=2
